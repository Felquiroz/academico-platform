{
  "buildCommand": "rm -rf node_modules/.vite node_modules/.cache dist && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "VITE_API_URL": "@vercel-env-api-url"
  },
  "installCommand": "rm -rf node_modules && npm install"
}